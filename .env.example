# Copy to .env to override the development defaults used by docker-compose.yml.
# Never commit a real .env: production secrets come from a secrets manager.

LOG_LEVEL=info

RABBITMQ_USER=maltashop
RABBITMQ_PASSWORD=maltashop-dev

ORDER_DB_PASSWORD=order-dev
INVENTORY_DB_PASSWORD=inventory-dev
PAYMENT_DB_PASSWORD=payment-dev
NOTIFICATION_DB_PASSWORD=notification-dev

# Payment provider simulation
PSP_TIMEOUT_MS=2000
# true = the primary provider returns errors, so the breaker opens and payments fail over
PSP_PRIMARY_SIMULATE_OUTAGE=false

# CI overrides: run a specific, already-built Order image
# ORDER_IMAGE=ghcr.io/<owner>/maltashop-order:<git-sha>
# ORDER_VERSION=<git-sha>

# Host port for the Order API (change it if 8080 is taken on your machine)
ORDER_HOST_PORT=8080
